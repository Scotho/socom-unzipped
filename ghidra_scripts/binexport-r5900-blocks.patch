+  // PATCH (socom-unzipped docs/research/49-bindiff-crosscheck.md), against v12-20240417-ghidra_11.0.3.
+  // Two defects on an R5900 program whose function table is imposed rather than discovered:
+  //  1. BasicBlockModel.getCodeBlocks() stops at the first `sync` instruction, so most blocks were never
+  //     indexed and buildFlowGraphs failed with a NullPointerException.
+  //  2. A function whose entry is reached by fall-through (no reference) sits inside a block that starts
+  //     in the previous function; its flow graph got no entry block (index 0 by default), which BinDiff
+  //     rejects ("AttachFlowGraph: flow graph already attached").
+  // So blocks are built per function: every model block intersected with the function's body, split at
+  // the function's entry. Bodies do not overlap, so the clipped blocks are disjoint and keyed by start.
+  // An edge whose target is not a block of the same function is dropped; a flow graph with no entry
+  // block is not written; both are counted in the log.
+  private final java.util.TreeMap<Address, Address> clipMax = new java.util.TreeMap<>();
+  private final Map<Address, CodeBlock> clipOrig = new HashMap<>();
+  private final Map<Function, java.util.List<Address>> funcBlocks = new java.util.LinkedHashMap<>();
+
+  private void addClip(Function f, Address min, Address max, CodeBlock orig) {
+    if (!listing.getInstructions(new ghidra.program.model.address.AddressSet(min, max), true).hasNext()) {
+      return; // data, or bytes never disassembled: not a basic block
+    }
+    if (clipMax.containsKey(min)) {
+      return;
+    }
+    clipMax.put(min, max);
+    clipOrig.put(min, orig);
+    funcBlocks.computeIfAbsent(f, k -> new ArrayList<>()).add(min);
+  }
