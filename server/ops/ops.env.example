# server/ops/ops.env -- the shape of the one file the box scripts read (Sprint 13 Task O3).
#
# Copy this file to ops.env beside it (git-ignored) and fill in the real values; on the box, copy it to
# /etc/socom-unzipped/ops.env (root-owned, mode 600). Every secret, address and key path the scripts use lives
# here and nowhere in the tracked scripts. KEY=value, one per line, no spaces around '=', no shell code:
# backup.sh and health.sh source it with bash, backup-pull.ps1 parses it line by line.
# The values below are placeholders: 203.0.113.0/24 is RFC 5737's documentation range, which the puller refuses.

# --- on the box (backup.sh, health.sh) -------------------------------------------------------------------------
# The installed server folder (linux/install.sh's DEST) and where the backup sets go.
OPS_SERVER_DIR=/opt/socom-unzipped-server
OPS_BACKUP_DIR=/var/backups/socom-unzipped
# How many backup sets the box keeps.
OPS_BACKUP_KEEP=30
# Seconds between the two copies of the live database that must agree before a set is kept.
OPS_BACKUP_SETTLE_SEC=2
# Medius's stats endpoint as the box itself reaches it (medius.json: StatsPrefix).
OPS_STATS_URL=http://127.0.0.1:10080/stats
# The repository commit that was deployed, written at deploy time; health.sh warns when the running server's
# "build" (the stats JSON, /api/stats on the site) says something else. Empty = not compared.
OPS_DEPLOYED_COMMIT=

# --- on the owner's machine (backup-pull.ps1) -------------------------------------------------------------------
# The box's address or name, the SSH user, the private key, and the known_hosts file that pins the box's host key.
OPS_BOX_HOST=203.0.113.10
OPS_BOX_USER=ubuntu
OPS_SSH_KEY=C:/path/to/the/box/key
OPS_KNOWN_HOSTS=C:/path/to/known_hosts
# Where pulled sets land, one folder per set (<OPS_PULL_DIR>/<stamp>/). Keep it outside the repository or under
# an ignored folder; server/ops/pulled/ is ignored.
OPS_PULL_DIR=C:/path/to/socom-backups
